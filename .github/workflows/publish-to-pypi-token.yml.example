# 这是使用 API Token 方式的备选配置示例
# 如果你想使用 Token 而不是 OIDC，可以：
# 1. 将此文件重命名为 publish-to-pypi-token.yml
# 2. 删除或禁用 publish-to-pypi.yml
# 3. 在 GitHub 配置 PYPI_API_TOKEN secret

name: Publish to PyPI (Token)

on:
  push:
    branches:
      - master
  pull_request:
    branches:
      - master
    types: [closed]

jobs:
  publish:
    if: github.event_name == 'push' || (github.event.pull_request.merged == true)
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install build twine

    - name: Build package
      run: python -m build

    - name: Check distribution
      run: twine check dist/*

    - name: Publish to PyPI using Token
      env:
        TWINE_USERNAME: __token__
        TWINE_PASSWORD: ${{ secrets.PYPI_API_TOKEN }}
      run: twine upload dist/*

